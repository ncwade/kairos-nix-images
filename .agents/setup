#!/usr/bin/env bash
set -euo pipefail

if [[ ! -x "$HOME/.nix-profile/bin/nix" ]]; then
  echo "Installing Nix"
  sudo mkdir -p /nix
  sudo chown "$(id -u):$(id -g)" /nix
  installer=$(mktemp)
  trap 'rm -f "$installer"' EXIT
  curl --proto '=https' --tlsv1.2 --fail --silent --show-error --location \
    https://nixos.org/nix/install > "$installer"
  sh "$installer" --no-daemon --yes
fi

# shellcheck disable=SC1091
source "$HOME/.nix-profile/etc/profile.d/nix.sh"

mkdir -p "$HOME/.config/nix"
if ! grep -Eq '^[[:space:]]*experimental-features[[:space:]]*=.*\bnix-command\b.*\bflakes\b' \
  "$HOME/.config/nix/nix.conf" 2>/dev/null; then
  printf '%s\n' 'experimental-features = nix-command flakes' \
    >> "$HOME/.config/nix/nix.conf"
fi

nix --version
nix flake metadata path:. --no-write-lock-file >/dev/null
